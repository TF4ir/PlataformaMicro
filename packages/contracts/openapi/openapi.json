{
  "openapi": "3.1.0",
  "info": {
    "title": "Plataforma de Microaprendizaje Adaptativo API",
    "version": "1.0.0",
    "description": "Contratos formales de API REST para inferencia temporal, evaluación de eventos de respuesta, explicabilidad SHAP y recomendaciones pedagógicas adaptativas.",
    "contact": {
      "name": "Equipo de Arquitectura e Inteligencia Artificial",
      "email": "investigacion@plataformamicro.edu.pe"
    }
  },
  "servers": [
    {
      "url": "https://api.plataformamicro.edu.pe",
      "description": "Servidor de Producción (blitz.cloud)"
    },
    {
      "url": "http://localhost:8000",
      "description": "Servidor Local de Desarrollo"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/diagnostic/answers": {
      "post": {
        "summary": "Registrar y evaluar respuesta de estudiante a reactivo",
        "operationId": "submit_diagnostic_answer",
        "tags": ["Evaluación y Aprendizaje"],
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Idempotency-Key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerEventSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Evento de respuesta persistido inmutablemente en answer_events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerEventSubmitResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntityProblem"
          }
        }
      }
    },
    "/api/v1/learning/attempts/{attempt_id}/answers": {
      "post": {
        "summary": "Registrar respuesta asociada a un intento de actividad específico",
        "operationId": "submit_attempt_answer",
        "tags": ["Evaluación y Aprendizaje"],
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "description": "UUID del intento en curso",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/X-Idempotency-Key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerEventSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Respuesta evaluada y registrada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerEventSubmitResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntityProblem"
          }
        }
      }
    },
    "/api/v1/ml/predict-risk": {
      "post": {
        "summary": "Calcular predicción multihorizonte de retención y riesgo cognitivo",
        "operationId": "predict_retention_risk",
        "tags": ["Inferencia y Machine Learning"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRiskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inferencia generada exitosamente o fallback por historial insuficiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictRiskResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntityProblem"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailableProblem"
          }
        }
      }
    },
    "/api/v1/predictions/retention": {
      "post": {
        "summary": "Calcular probabilidades de retención proyectadas (alias homologado)",
        "operationId": "predict_retention_alias",
        "tags": ["Inferencia y Machine Learning"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRiskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de la proyección probabilística de retención",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictRiskResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntityProblem"
          }
        }
      }
    },
    "/api/v1/recommendations/{student_id}": {
      "get": {
        "summary": "Obtener recomendaciones activas y microcontenidos asignados",
        "operationId": "get_student_recommendations",
        "tags": ["Adaptación Pedagógica"],
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "description": "UUID del estudiante",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "risk_threshold",
            "in": "query",
            "required": false,
            "description": "Umbral de corte de riesgo para filtrar (default: 0.65)",
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.65
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Número máximo de recomendaciones a recuperar",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Estado de las recomendaciones a filtrar",
            "schema": {
              "type": "string",
              "enum": ["pending", "delivered", "completed", "all"],
              "default": "pending"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de recomendaciones pedagógicas adaptativas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRecommendationsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          }
        }
      }
    },
    "/api/v1/recommendations/generate": {
      "post": {
        "summary": "Generar recomendación pedagógica adaptativa bajo demanda",
        "operationId": "generate_adaptive_recommendation",
        "tags": ["Adaptación Pedagógica"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["student_id", "knowledge_component_id"],
                "properties": {
                  "student_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "knowledge_component_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "risk_threshold": {
                    "type": "number",
                    "default": 0.65
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recomendación pedagógica generada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationItem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntityProblem"
          }
        }
      }
    },
    "/api/v1/health/warmup": {
      "post": {
        "summary": "Warmup ping para mitigar arranque en frío en blitz.cloud",
        "operationId": "warmup_service",
        "tags": ["Monitoreo y Operaciones"],
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio activo y modelos cargados en memoria",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarmupResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "X-Idempotency-Key": {
        "name": "X-Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Identificador UUIDv4 único generado por el cliente para evitar procesamiento duplicado",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "AnswerEventSubmitRequest": {
        "type": "object",
        "description": "Payload para registrar y evaluar una respuesta a reactivo",
        "required": [
          "question_id",
          "selected_option_id",
          "response_time_seconds"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID del intento en quiz_attempts"
          },
          "question_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID de la pregunta respondida"
          },
          "selected_option_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID de la alternativa seleccionada"
          },
          "response_time_seconds": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 600.0,
            "description": "Tiempo cronometrado de respuesta en segundos"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "description": "UUID de idempotencia para la transacción"
          }
        },
        "additionalProperties": false
      },
      "AnswerEventSubmitResponse": {
        "type": "object",
        "description": "Resultado de la evaluación formativa y persistencia del evento",
        "required": [
          "event_id",
          "is_correct",
          "feedback",
          "next_question_index",
          "attempt_completed"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID inmutable asignado en answer_events"
          },
          "is_correct": {
            "type": "boolean",
            "description": "Indica si la respuesta fue correcta"
          },
          "feedback": {
            "type": "object",
            "required": ["title", "explanation"],
            "properties": {
              "title": {
                "type": "string",
                "example": "¡Respuesta Correcta!"
              },
              "explanation": {
                "type": "string",
                "example": "La mitocondria produce ATP celular mediante fosforilación oxidativa."
              }
            },
            "additionalProperties": false
          },
          "next_question_index": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Índice de la siguiente pregunta de la actividad"
          },
          "attempt_completed": {
            "type": "boolean",
            "description": "Indica si el intento concluyó"
          },
          "current_score": {
            "type": ["number", "null"],
            "minimum": 0.0,
            "maximum": 100.0,
            "description": "Calificación acumulada calculada"
          }
        },
        "additionalProperties": false
      },
      "PredictRiskRequest": {
        "type": "object",
        "description": "Cuerpo de solicitud para inferencia de retención y riesgo",
        "required": [
          "student_id",
          "knowledge_component_id"
        ],
        "properties": {
          "student_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID del perfil del estudiante"
          },
          "knowledge_component_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID del Knowledge Component objetivo"
          },
          "horizons_hours": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "default": [24, 72, 168],
            "description": "Horizontes de proyección en horas"
          },
          "include_shap_values": {
            "type": "boolean",
            "default": false,
            "description": "Incluir explicabilidad local SHAP"
          }
        },
        "additionalProperties": false
      },
      "PredictionItem": {
        "type": "object",
        "description": "Estimación probabilística para un horizonte temporal específico",
        "required": [
          "horizon_hours",
          "recall_probability",
          "estimated_risk",
          "risk_level"
        ],
        "properties": {
          "horizon_hours": {
            "type": "integer",
            "minimum": 1,
            "description": "Horizonte temporal proyectado en horas"
          },
          "prediction_horizon_hours": {
            "type": "integer",
            "minimum": 1,
            "description": "Alias explícito del horizonte proyectado"
          },
          "recall_probability": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Probabilidad proyectada de recuerdo P(R=1 | h)"
          },
          "predicted_recall_probability": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Alias explícito de la probabilidad estimada"
          },
          "estimated_risk": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Nivel de riesgo estimado (1.0 - recall_probability)"
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Categorización pedagógica del riesgo"
          }
        },
        "additionalProperties": false
      },
      "PredictRiskResponse": {
        "type": "object",
        "description": "Respuesta estructurada de inferencia predictiva",
        "required": [
          "prediction_status",
          "student_id",
          "knowledge_component_id",
          "predictions"
        ],
        "properties": {
          "prediction_status": {
            "type": "string",
            "enum": [
              "valid",
              "insufficient_history",
              "degraded_fallback"
            ],
            "description": "Estado del proceso de inferencia"
          },
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "knowledge_component_id": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "DAS3H"
              },
              "version": {
                "type": "string",
                "example": "1.0.0"
              }
            }
          },
          "predictions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PredictionItem"
            }
          },
          "feature_importance": {
            "type": ["object", "null"],
            "additionalProperties": {
              "type": "number"
            },
            "description": "Atribuciones de importancia de características SHAP"
          },
          "input_event_cutoff": {
            "type": "string",
            "format": "date-time",
            "description": "Corte temporal de eventos para evitar data leakage"
          },
          "reason": {
            "type": ["string", "null"],
            "description": "Detalle explicativo en caso de insuficiencia de datos"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "MicrocontentSummary": {
        "type": "object",
        "description": "Resumen del recurso de microaprendizaje asociado",
        "required": [
          "id",
          "title",
          "content_type",
          "estimated_duration_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "text_summary",
              "infographic_card",
              "concept_map"
            ]
          },
          "estimated_duration_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 600
          }
        },
        "additionalProperties": false
      },
      "RecommendationItem": {
        "type": "object",
        "description": "Recomendación adaptativa individual",
        "required": [
          "id",
          "knowledge_component_id",
          "knowledge_component_name",
          "microcontent",
          "risk_score",
          "selection_method",
          "decision_reason",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "knowledge_component_id": {
            "type": "string",
            "format": "uuid"
          },
          "knowledge_component_name": {
            "type": "string"
          },
          "microcontent": {
            "$ref": "#/components/schemas/MicrocontentSummary"
          },
          "risk_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "selection_method": {
            "type": "string",
            "enum": [
              "predictive_model",
              "rule_based_fallback",
              "teacher_assigned"
            ]
          },
          "decision_reason": {
            "type": "string"
          },
          "review_activity_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "completed",
              "dismissed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "GetRecommendationsResponse": {
        "type": "object",
        "description": "Colección de recomendaciones para el estudiante",
        "required": [
          "student_id",
          "total_recommendations",
          "recommendations"
        ],
        "properties": {
          "student_id": {
            "type": "string",
            "format": "uuid"
          },
          "total_recommendations": {
            "type": "integer",
            "minimum": 0
          },
          "recommendations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            }
          }
        },
        "additionalProperties": false
      },
      "WarmupResponse": {
        "type": "object",
        "description": "Resultado de la verificación de calentamiento de contenedor",
        "required": [
          "status",
          "warmed",
          "models_loaded",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "warmed": {
            "type": "boolean",
            "example": true
          },
          "models_loaded": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["DAS3H", "BKT"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "description": "Modelo formal de error conforme a RFC 7807",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://api.plataformamicro.edu.pe/errors/invalid-request"
          },
          "title": {
            "type": "string",
            "example": "Petición Inválida"
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Los parámetros suministrados no superaron la validación de esquema."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/diagnostic/answers"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "Petición con sintaxis errónea o parámetros incompatibles",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Falta de autenticación o token Supabase JWT inválido / expirado",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "El usuario no cuenta con privilegios para acceder al recurso solicitado",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "El recurso solicitado no fue encontrado",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "Conflicto de idempotencia o estado duplicado detectado",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "UnprocessableEntityProblem": {
        "description": "Error de validación semántica de campos por Pydantic v2",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ServiceUnavailableProblem": {
        "description": "El servicio predictivo se encuentra temporalmente fuera de línea o en arranque en frío",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT de sesión emitido por Supabase Auth (GoTrue)"
      }
    }
  }
}
