{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plataformamicro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "test -n \"$OPEN_NEXT_ALREADY_BUILT\" || npm run build:cloudflare"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://oqjahhbqcethwgpufgnm.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_u5AIwepBNqqKzQPxVtg5QQ_d_IQ3yrX",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_u5AIwepBNqqKzQPxVtg5QQ_d_IQ3yrX",
    "NEXT_PUBLIC_API_URL": "https://54wsiki2ruyk2r5l3xvasykqo40oxokx.lambda-url.us-east-2.on.aws",
    "NEXT_PUBLIC_ENABLE_DEMO_AUTH": "false"
  },
  "env": {
    "preview": {
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://oqjahhbqcethwgpufgnm.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_u5AIwepBNqqKzQPxVtg5QQ_d_IQ3yrX",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_u5AIwepBNqqKzQPxVtg5QQ_d_IQ3yrX",
        "NEXT_PUBLIC_API_URL": "https://54wsiki2ruyk2r5l3xvasykqo40oxokx.lambda-url.us-east-2.on.aws",
        "NEXT_PUBLIC_ENABLE_DEMO_AUTH": "true"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
