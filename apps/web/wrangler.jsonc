{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plataformamicro",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://oqjahhbqcethwgpufgnm.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_u5AIwepBNqqKzQPxVtg5QQ_d_IQ3yrX",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_u5AIwepBNqqKzQPxVtg5QQ_d_IQ3yrX",
    "NEXT_PUBLIC_ENABLE_DEMO_AUTH": "true"
  },
  "observability": {
    "enabled": true
  }
}
