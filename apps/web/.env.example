# ==============================================================================
# NEXO WEB CLIENT ENVIRONMENT TEMPLATE
# ==============================================================================

# Supabase Persistence & Identity (Client-safe anon credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Microservicio Predictivo FastAPI (Optional for local hybrid mode)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo Mode (Explicitly disabled by default, strictly forbidden in production)
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
