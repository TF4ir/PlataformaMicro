# ==============================================================================
# ML-API FASTAPI SERVICE ENVIRONMENT TEMPLATE
# ==============================================================================

API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# Database / Supabase
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Adaptive Pedagogical Engine
ADAPTATION_DEFAULT_THRESHOLD=0.65
MIN_ATTEMPTS_FOR_INFERENCE=3
BLITZ_WARMUP_SECRET=change-this-secret-in-production
MODEL_ARTIFACTS_DIR=/app/artifacts
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Assisted Content Generation & LLM Providers (ADR-0004 / M2.4)
LLM_PROVIDER=mock
LLM_MODEL_ID=mock-v1
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4096
