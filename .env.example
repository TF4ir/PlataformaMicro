# ==============================================================================
# PLATAFORMA DE MICROAPRENDIZAJE ADAPTATIVO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO GLOBAL Y TELEMETRÍA
# ------------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# ------------------------------------------------------------------------------
# 2. PERSISTENCIA POSTGRESQL & SUPABASE (LOCAL / PRODUCCIÓN)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Credenciales de Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_with_at_least_32_characters_here
SUPABASE_JWT_AUDIENCE=authenticated

# ------------------------------------------------------------------------------
# 3. FRONTEND NEXT.JS (APPS/WEB)
# ------------------------------------------------------------------------------
# Variables públicas consumibles en navegador
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. MICROSERVICIO PREDICTIVO FASTAPI (SERVICES/ML-API)
# ------------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ML_API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Parámetros del Motor de Adaptación Pedagógica
ADAPTATION_DEFAULT_THRESHOLD=0.65
MIN_ATTEMPTS_FOR_INFERENCE=3
BLITZ_WARMUP_SECRET=warmup-development-key-change-in-prod
MODEL_ARTIFACTS_DIR=/app/artifacts

# ------------------------------------------------------------------------------
# 5. INVESTIGACIÓN Y ENTRENAMIENTO ML (ML/)
# ------------------------------------------------------------------------------
ML_EXPERIMENT_NAME=das3h-ciencias-5to
RANDOM_SEED=42
DATASETS_DIR=./ml/datasets
ARTIFACTS_DIR=./ml/artifacts
STUDENT_GROUP_K_FOLDS=5
